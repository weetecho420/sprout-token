# Copy this file to .env and fill it in. Never commit .env.

# Helius RPC URL. Start with devnet; switch to mainnet only for the real sale.
RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_KEY

# Path to the deploy wallet file made with solana-keygen (keep it OUT of this folder)
DEPLOYER_KEYPAIR=/home/you/sprout-deployer.json

# Your Squads Vault address (where license payments go)
TREASURY=YOUR_SQUADS_VAULT_ADDRESS

# Filled in after running `npm run upload`
LICENSE_URI=
COLLECTION_URI=

# Sale settings
PRICE_SOL=0.5
TOTAL_LICENSES=1000
MAX_PER_WALLET=5
SALE_START=2027-03-01T00:00:00Z
