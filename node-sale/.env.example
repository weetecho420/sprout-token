# Copy this file to .env and fill it in. Never commit .env.

# Helius RPC URL. Start with devnet; switch to mainnet only for the real sale.
RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_KEY

# Path printed by `npm run new-wallet` (keep it OUT of this folder)
# Windows example: C:\Users\Henry\sprout-deployer.json
DEPLOYER_KEYPAIR=

# Where license payments go.
# Devnet test: your Phantom "Sprout" wallet address.
# Real sale: your Squads Vault address.
TREASURY=

# Filled in after running `npm run upload`
LICENSE_URI=
COLLECTION_URI=

# Sale settings
PRICE_SOL=0.5
TOTAL_LICENSES=1000
MAX_PER_WALLET=5
# For the devnet test, use a date in the past so you can buy right away.
# For the real sale: 2027-03-01T00:00:00Z
SALE_START=2026-10-01T00:00:00Z
