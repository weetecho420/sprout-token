# PRIVATE REAL-MONEY TEST on mainnet. Copy to .env.mainnet (Windows: copy .env.mainnet.example .env.mainnet)
# Never commit .env.mainnet.

# Same Helius key as devnet, but the MAINNET address
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Same deploy wallet file as in .env (it needs ~0.15 real SOL for setup fees)
DEPLOYER_KEYPAIR=

# For this private test, payments go to YOUR Phantom wallet.
# For the real public sale, this must be your Squads vault.
TREASURY=

# Tiny test price so testing costs almost nothing
PRICE_SOL=0.01
# A date in the past, so you can buy straight away
SALE_START=2026-10-01T00:00:00Z
