# Copy to .env.local for local testing. On Netlify, add these under
# Project configuration → Environment variables.

# devnet while testing, mainnet-beta for the real sale
VITE_NETWORK=devnet

# Helius RPC URL (needed for the "My Nodes" page)
VITE_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_KEY

# Printed by `npm run setup` in node-sale/
VITE_CANDY_MACHINE=
